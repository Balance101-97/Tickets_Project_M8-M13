{
    "env": {
      "node": true,
      "es2022": true
    },
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": "warn",
      "no-undef": "warn",
      "no-console": "off",
      "semi": "off"
    },
    "ignorePatterns": [
      "node_modules/",
      "data/",
      "coverage/"
    ]
  }